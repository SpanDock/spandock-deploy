# Managed by Ansible.
[Unit]
Description=SpanDock Server
Wants=network-online.target
After=network-online.target

[Service]
User={{ spandock_user }}
Group={{ spandock_user }}
EnvironmentFile=/etc/spandock/server.env
WorkingDirectory={{ spandock_home }}
ExecStart={{ spandock_home }}/bin/spandock -role=server -open=false -menubar=false
Restart=always
RestartSec=5
# Stopping the old process must not kill the self-update helper (it rolls back a broken update).
KillMode=process
StandardOutput=journal+console
StandardError=journal+console
# Lets the public endpoint listen on 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
